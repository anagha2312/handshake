# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Leave empty to run in simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook ID from the same app, for verified webhooks (needs a public URL)
PAYPAL_WEBHOOK_ID=

# Google Gemini API key (free at aistudio.google.com)
GEMINI_API_KEY=

# Sandbox test accounts: emails prefill the forms; passwords are only used by scripts/e2e.mjs
SANDBOX_CLIENT_EMAIL=
SANDBOX_CLIENT_PASSWORD=
SANDBOX_FREELANCER_EMAIL=

# Optional
# APP_URL=https://your-app.onrender.com
# AUTO_RELEASE_HOURS=72
# DEMO_MODE=true
# PAYPAL_MODE=mock          # force simulation even with credentials
# PAYOUTS_FALLBACK=simulate # if your sandbox business account's region can't send Payouts
